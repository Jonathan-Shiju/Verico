# One of these is enough for the operator session and for a lead review.
# HUGGING_FACE_HUB_TOKEN is read the same way as HF_TOKEN.
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# gemini, openai, or huggingface. Empty uses the first key that is set.
INVESTIGATOR_PROVIDER=
INVESTIGATOR_MODEL=

# Public address of the chat API, such as http://203.0.113.10:8787
# Leave empty to use this machine.
DEMO_API_URL=

# Site allowed to call that API, such as https://your-app.vercel.app
# Optional comma-separated browser origins. Local defaults are localhost:3000.
VERICO_ORIGIN=

# Used by web/next.config.mjs. Leave empty for the local chat API.
DEMO_API_UPSTREAM=
NEXT_PUBLIC_DEMO_API=
